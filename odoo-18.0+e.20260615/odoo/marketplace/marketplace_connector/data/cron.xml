<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_export_stock" model="ir.cron">
        <field name="name">Marketplace : export du stock</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_export_stock()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="cron_export_price" model="ir.cron">
        <field name="name">Marketplace : export des prix</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_export_price()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="cron_import_orders" model="ir.cron">
        <field name="name">Marketplace : import des commandes</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_orders()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
