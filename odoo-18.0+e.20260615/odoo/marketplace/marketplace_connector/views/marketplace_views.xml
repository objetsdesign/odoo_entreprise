<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_list" model="ir.ui.view">
        <field name="name">marketplace.marketplace.list</field>
        <field name="model">marketplace.marketplace</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="account_count"/>
            </list>
        </field>
    </record>

    <record id="view_marketplace_form" model="ir.ui.view">
        <field name="name">marketplace.marketplace.form</field>
        <field name="model">marketplace.marketplace</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <field name="account_ids">
                        <list>
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketplace" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">marketplace.marketplace</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
