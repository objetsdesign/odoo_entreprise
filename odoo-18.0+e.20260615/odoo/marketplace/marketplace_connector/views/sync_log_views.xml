<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sync_log_list" model="ir.ui.view">
        <field name="name">marketplace.sync.log.list</field>
        <field name="model">marketplace.sync.log</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="operation"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'error'"/>
                <field name="order_ref"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_sync_log_search" model="ir.ui.view">
        <field name="name">marketplace.sync.log.search</field>
        <field name="model">marketplace.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <filter name="errors" string="Erreurs"
                        domain="[('status', '=', 'error')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_account" string="Compte"
                            context="{'group_by': 'account_id'}"/>
                    <filter name="group_op" string="Opération"
                            context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sync_log" model="ir.actions.act_window">
        <field name="name">Journal de synchronisation</field>
        <field name="res_model">marketplace.sync.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
