<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketplace" model="ir.module.category">
        <field name="name">Marketplace</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_marketplace_user" model="res.groups">
        <field name="name">Marketplace / Utilisateur</field>
        <field name="category_id" ref="module_category_marketplace"/>
    </record>

    <record id="group_marketplace_manager" model="res.groups">
        <field name="name">Marketplace / Responsable</field>
        <field name="category_id" ref="module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('group_marketplace_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_marketplace_account_company" model="ir.rule">
        <field name="name">Compte marketplace : multi-sociétés</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
