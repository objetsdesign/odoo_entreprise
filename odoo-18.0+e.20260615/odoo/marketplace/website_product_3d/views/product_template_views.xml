<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_p3d" model="ir.ui.view">
        <field name="name">product.template.form.3d</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Aperçu 3D" name="product_3d">
                    <group>
                        <field name="is_3d"/>
                        <field name="p3d_glb" filename="p3d_glb_filename"
                               widget="binary" invisible="not is_3d"/>
                        <field name="p3d_glb_filename" invisible="1"/>
                        <field name="p3d_shape" invisible="not is_3d or p3d_glb"/>
                        <div colspan="2" class="text-muted"
                             invisible="not is_3d or not p3d_glb">
                            Un modèle .glb est importé : il s'affiche tel quel.
                            Les couleurs ci-dessous s'appliquent alors comme une
                            teinte sur la matière, et le logo se compose sur sa
                            texture d'origine.
                        </div>
                    </group>
                    <separator string="Couleurs de matière"
                               invisible="not is_3d"/>
                    <field name="p3d_color_ids" invisible="not is_3d">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="html_color" widget="color"/>
                            <field name="extra_price"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
