<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="vc_demo_mug" model="product.template">
            <field name="name">Tasse artisanale à personnaliser</field>
            <field name="type">consu</field>
            <field name="sale_ok" eval="True"/>
            <field name="website_published" eval="True"/>
            <field name="list_price">19.0</field>
            <field name="is_visual_customizer" eval="True"/>
            <field name="vc_color_target">#part_body</field>
            <field name="vc_area">135,205,100,115</field>
            <field name="vc_svg"><![CDATA[
<svg id="vc_svg" viewBox="0 0 400 440" xmlns="http://www.w3.org/2000/svg">
  <path id="part_handle" fill="#e0c9a6" stroke="#7a5c3a" stroke-width="4" stroke-linejoin="round"
        d="M250 175 C300 175 322 205 322 237 C322 272 296 305 250 305
           L250 282 C284 282 298 262 298 237 C298 213 284 198 250 198 Z"/>
  <path id="part_body" fill="#efe6da" stroke="#7a5c3a" stroke-width="4" stroke-linejoin="round"
        d="M120 158 C120 152 124 150 130 150 L240 150 C246 150 250 152 250 158
           L240 360 C239 371 232 374 224 374 L146 374 C138 374 131 371 130 360 Z"/>
  <ellipse id="part_inside" cx="185" cy="153" rx="65" ry="14"
           fill="#b9a78f" stroke="#7a5c3a" stroke-width="4"/>
</svg>
            ]]></field>
        </record>

        <record id="vc_color_cream" model="product.vc.color">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Crème</field><field name="html_color">#efe6da</field>
            <field name="sequence">10</field>
        </record>
        <record id="vc_color_terracotta" model="product.vc.color">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Terracotta</field><field name="html_color">#c0532f</field>
            <field name="sequence">20</field>
        </record>
        <record id="vc_color_green" model="product.vc.color">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Vert sauge</field><field name="html_color">#2f6f4f</field>
            <field name="sequence">30</field>
        </record>
        <record id="vc_color_blue" model="product.vc.color">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Bleu nuit</field><field name="html_color">#2c4a6e</field>
            <field name="sequence">40</field>
        </record>

        <record id="vc_dim_height" model="product.vc.dimension">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Hauteur</field><field name="unit">cm</field>
            <field name="min_value">8</field><field name="max_value">14</field>
            <field name="default_value">10</field>
            <field name="sequence">10</field>
        </record>
        <record id="vc_dim_diameter" model="product.vc.dimension">
            <field name="product_tmpl_id" ref="vc_demo_mug"/>
            <field name="name">Diamètre</field><field name="unit">cm</field>
            <field name="min_value">6</field><field name="max_value">10</field>
            <field name="default_value">8</field>
            <field name="sequence">20</field>
        </record>

    </data>
</odoo>
