<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_measure" model="ir.ui.view">
        <field name="name">product.template.form.custom.measure</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Mesures sur mesure" name="custom_measure">
                    <group>
                        <field name="is_custom_measure"/>
                    </group>
                    <field name="measure_field_ids" invisible="not is_custom_measure">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="field_type"/>
                            <field name="unit"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="selection_options"/>
                            <field name="required"/>
                            <field name="help_text"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
